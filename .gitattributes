# 统一行尾，避免 Windows 上每次 add 都刷一屏 "LF will be replaced by CRLF"
# 只声明 text=auto（跟随 core.autocrlf），不强制 eol，避免一次性重写全部文件

* text=auto

# 明确文本类型
*.rs    text
*.toml  text
*.md    text
*.vue   text
*.ts    text
*.js    text
*.json  text
*.yaml  text
*.yml   text
*.html  text
*.css   text
*.sql   text
*.sh    text

# 二进制：不要做行尾转换，也不要 diff
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.exe   binary

# 锁文件：review 时折叠，不算业务改动
Cargo.lock      linguist-generated=true
pnpm-lock.yaml  linguist-generated=true
package-lock.json linguist-generated=true
