# 复制为 .env 后按需修改（本项目直接读环境变量，不自动加载 .env）
FLINKOPS_BIND=0.0.0.0:8080
FLINKOPS_WEB_DIR=./apps/web/dist

# 动态接入时「粘贴 kubeconfig」落到哪里（默认：SQLite 同级的 clusters/）
# FLINKOPS_CLUSTERS_DIR=./data/clusters

# sqlite（默认）| postgres://user:pass@host:5432/flinkops
# MySQL 也可用；注意长文本列在 MySQL 上是 MEDIUMTEXT（sqlx::Any 会把 TEXT 报成 BLOB）
FLINKOPS_STORE=sqlite://./data/flinkops.db?mode=rwc

# id=incluster 或 id=/path/to/kubeconfig，逗号分隔；留空表示不接集群（仅静态页 + 空索引）
FLINKOPS_CLUSTERS=local=incluster

# 平台级只读（true 时拒绝所有写 API）
FLINKOPS_READONLY=false

# 留空 = 只有 Flink REST 实时数据；填了才有历史/聚合
FLINKOPS_PROMETHEUS_URL=

FLINKOPS_ADMIN_USER=admin
FLINKOPS_ADMIN_PASSWORD=admin

FLINKOPS_AUDIT_RETENTION_DAYS=90
FLINKOPS_DB_MAX_MB=512

RUST_LOG=info,tower_http=warn

# ---- MCP（可选，只给 flinkops-mcp 这个二进制用；平台本身不需要这几个）----
# Token 在 网页 →「MCP 与审批」创建，形如 fko_pat_<id>_<secret>，只显示一次
# FLINKOPS_URL=http://127.0.0.1:8080
# FLINKOPS_MCP_TOKEN=fko_pat_xxxxxxxx_yyyyyyyy
# 可选：默认审批 token（网页审批后拿到，一次有效；不想每次带 approvalToken 时才用）
# FLINKOPS_MCP_APPROVAL=
