*.log
/tmp

# 发行产物与本地工具链（NSIS 等，不入库）
/dist/
/release/
.tools/

# Python 缓存（scripts/*.py 被 release_notes.py 导入时会生成）
__pycache__/
*.pyc

# vue-tsc 的编译副产物（与 .ts/.vue 同名同目录，别提交）
apps/web/src/**/*.js
apps/web/vite.config.js
apps/web/tsconfig.tsbuildinfo
*.tsbuildinfo

# vue-tsc 曾经把产物落到源码树（已加 noEmit，这里兜底）
*.vue.js
apps/web/vite.config.js
tsconfig.tsbuildinfo

# 内部分析报告不进公开仓库（含内网域名/作业名），本地保留在 data/internal-reports/
docs/review-*.md
docs/manual-test-cases-*.csv
